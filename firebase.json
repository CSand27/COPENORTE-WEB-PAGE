        "type": 301
      },
      {
        "source": "/servicios.html",
        "destination": "/sectores-que-atendemos.html",
        "type": 301
      },
      {
        "source": "/quiénes-somos",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/identidad-corporativa",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/sectores-que-atendemos",
        "destination": "/sectores-que-atendemos.html",
        "type": 301
      },
      {
        "source": "/diseno",
        "destination": "/diseno.html",
        "type": 301
      },
      {
        "source": "/diseño",
        "destination": "/diseno.html",
        "type": 301
      },
      {
        "source": "/manufactura-industrial",
        "destination": "/manufactura-industrial.html",
        "type": 301
      },
      {
        "source": "/corte-laser",
        "destination": "/manufactura-industrial.html",
        "type": 301
      },
      {
        "source": "/corte-laser.html",
        "destination": "/manufactura-industrial.html",
        "type": 301
      },
      {
        "source": "/en/corte-laser.html",
        "destination": "/en/manufactura-industrial.html",
        "type": 301
      },
      {
        "source": "/contacto",
        "destination": "/contacto.html",
        "type": 301
      }
    ]
  }
}
