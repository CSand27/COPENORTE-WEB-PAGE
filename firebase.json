{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "assets/img/LEEME.txt"
    ],
    "redirects": [
      {
        "source": "/inicio",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/servicios",
